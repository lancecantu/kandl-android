# Gradle
.gradle/
build/
captures/
local.properties

# Android build outputs
*.apk
*.aab
*.ap_
*.dex
*.class
output.json

# Firebase client config. Not a credential in the usual sense, but this app
# is not distributed publicly, so keeping it out of a public repo avoids
# handing out the project id and API key. See google-services.json.example.
app/google-services.json

# Signing material
*-firebase-adminsdk-*.json
serviceAccountKey.json
service-account*.json
*.jks
*.keystore
*.p12
*.pem
keystore.properties

# Native build
.externalNativeBuild/
.cxx/

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Android Studio / IntelliJ
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/deviceManager.xml
.idea/androidTestResultsUserPreferences.xml
.idea/shelf/
*.iml

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Must follow *.jar above (last matching rule wins). The wrapper jar has to
# stay tracked so `./gradlew` works on a fresh clone.
!gradle/wrapper/gradle-wrapper.jar

# BlueJ / J2ME leftovers
*.ctxt
.mtj.tmp/

# OS cruft
.DS_Store
Thumbs.db
